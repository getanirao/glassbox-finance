BOT_TOKEN=your_discord_bot_token_here
WEBHOOK_URL=your_discord_webhook_url_here
RUN_MODE=COMPETITION
DOCKER_PLATFORM=linux/arm64
PYTHON_VERSION=3.12
EXPORT_FINBERT=0
GLASSBOX_MEM_LIMIT=1536m
GLASSBOX_MEM_RESERVATION=512m
GLASSBOX_WORKER_MEM_LIMIT=768m
GLASSBOX_WORKER_MEM_RESERVATION=256m

# Passive MarketWatch bridge. Keep disabled until a public HTTPS reverse proxy
# forwards to the loopback-bound Docker port; never expose plain HTTP publicly.
MARKETWATCH_SYNC_ENABLED=false
MARKETWATCH_SYNC_BIND_ADDRESS=127.0.0.1
MARKETWATCH_SYNC_PORT=8765
MARKETWATCH_SYNC_TOKEN=replace_with_a_long_random_secret
MARKETWATCH_GAME_SLUG=wolves-of-wall-street---july-2026
MARKETWATCH_SYNC_MAX_STALENESS_SECONDS=300

# LLM summarization (optional, for article body sentiment enhancement)
# ENABLE_ARTICLE_SUMMARIZATION=false
# SUMMARIZE_PROVIDER=openai
# LLM_API_KEY=your_openai_or_anthropic_key
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
