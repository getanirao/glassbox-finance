# Local-only receiver. Copy to .marketwatch-bridge.env and replace the token.
MARKETWATCH_SYNC_ENABLED=false
MARKETWATCH_SYNC_HOST=0.0.0.0
MARKETWATCH_SYNC_PORT=8765
MARKETWATCH_SYNC_TOKEN=replace_with_a_long_random_secret
MARKETWATCH_GAME_SLUG=wolves-of-wall-street---july-2026
MARKETWATCH_SYNC_MAX_STALENESS_SECONDS=300
